{
  "name": "saltline-mp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Saltline online: 浏览器/安卓 FPS，支持搜打撤、大战场与联机",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "tunnel": "bash scripts/tunnel.sh",
    "fetch:cloudflared": "bash scripts/fetch-cloudflared.sh",
    "build:apk": "bash build-apk.sh",
    "test": "node tests/smoke.js && node tests/social.js",
    "supervise": "bash scripts/supervise.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
